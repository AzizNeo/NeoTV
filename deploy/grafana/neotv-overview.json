{
  "uid": "neotv-overview",
  "title": "NeoTV — overview",
  "tags": [
    "neotv"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Service level objectives — 30-day error budget left",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "API availability — budget left",
      "description": "Objective 99.5%. 100 % = no bad events this month; 0 % = budget spent (reliability work before features). Runbook: docs/runbooks.md",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - avg_over_time(neotv:sli_availability_errors:ratio_rate5m[30d]) / 0.005",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "API latency ≤ 1 s — budget left",
      "description": "Objective 99.0%. 100 % = no bad events this month; 0 % = budget spent (reliability work before features). Runbook: docs/runbooks.md",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - avg_over_time(neotv:sli_latency_errors:ratio_rate5m[30d]) / 0.01",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Playback start ≤ 3 s — budget left",
      "description": "Objective 95.0%. 100 % = no bad events this month; 0 % = budget spent (reliability work before features). Runbook: docs/runbooks.md",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - avg_over_time(neotv:sli_playback_start_errors:ratio_rate5m[30d]) / 0.05",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Error budget burn rate (1 h) — 14.4 pages, 6 opens a ticket",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "neotv:sli_availability_errors:ratio_rate1h / 0.005",
          "legendFormat": "API availability",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "neotv:sli_latency_errors:ratio_rate1h / 0.01",
          "legendFormat": "API latency ≤ 1 s",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "neotv:sli_playback_start_errors:ratio_rate1h / 0.05",
          "legendFormat": "Playback start ≤ 3 s",
          "refId": "C"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "API",
      "collapsed": false,
      "panels": [],
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by status class",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(neotv_http_requests_total{status=~\"2..\",endpoint!~\"kernel_health\\\\..*|kernel_metrics\\\\..*|kernel\\\\.client_events|playback\\\\.proxy\"}[5m]))",
          "legendFormat": "2xx",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(neotv_http_requests_total{status=~\"3..\",endpoint!~\"kernel_health\\\\..*|kernel_metrics\\\\..*|kernel\\\\.client_events|playback\\\\.proxy\"}[5m]))",
          "legendFormat": "3xx",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(neotv_http_requests_total{status=~\"4..\",endpoint!~\"kernel_health\\\\..*|kernel_metrics\\\\..*|kernel\\\\.client_events|playback\\\\.proxy\"}[5m]))",
          "legendFormat": "4xx",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(neotv_http_requests_total{status=~\"5..\",endpoint!~\"kernel_health\\\\..*|kernel_metrics\\\\..*|kernel\\\\.client_events|playback\\\\.proxy\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "D"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(neotv_http_request_seconds_bucket{endpoint!~\"kernel_health\\\\..*|kernel_metrics\\\\..*|kernel\\\\.client_events|playback\\\\.proxy\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(neotv_http_request_seconds_bucket{endpoint!~\"kernel_health\\\\..*|kernel_metrics\\\\..*|kernel\\\\.client_events|playback\\\\.proxy\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(neotv_http_request_seconds_bucket{endpoint!~\"kernel_health\\\\..*|kernel_metrics\\\\..*|kernel\\\\.client_events|playback\\\\.proxy\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Server errors by endpoint (top 5)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(5, sum by (endpoint) (rate(neotv_http_requests_total{status=~\"5..\",endpoint!~\"kernel_health\\\\..*|kernel_metrics\\\\..*|kernel\\\\.client_events|playback\\\\.proxy\"}[5m])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Playback",
      "collapsed": false,
      "panels": [],
