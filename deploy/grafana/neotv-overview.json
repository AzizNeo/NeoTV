    {
      "type": "timeseries",
      "title": "Time to first frame (p95) by device",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
