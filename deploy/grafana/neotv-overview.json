        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (device) (rate(neotv_playback_rebuffer_events_total[15m])) * 3600 / sum by (device) (rate(neotv_playback_watch_seconds_total[15m]))",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "id": 15,
