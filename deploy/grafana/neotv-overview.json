      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Rebuffering ratio by device",
      "description": "Share of viewing time spent stalled",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (device) (rate(neotv_playback_rebuffer_seconds_total[15m])) / (sum by (device) (rate(neotv_playback_watch_seconds_total[15m])) + sum by (device) (rate(neotv_playback_rebuffer_seconds_total[15m])))",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "id": 14,
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Stalls per hour of viewing, by device",
      "description": "How often playback stops (the ratio above says for how long): many short stalls hurt too",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
