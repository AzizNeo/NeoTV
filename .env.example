# ─────────────────────────────────────────────────────────────────────────────
# NeoTV configuration. Copy with:  python -m tools.devctl init-env
# Every key maps 1:1 to a field of app/kernel/settings.py (case-insensitive).
# Invalid values fail at startup with a named error (no silent defaults).
# ─────────────────────────────────────────────────────────────────────────────

# Runtime: dev | test | staging | prod   (prod enforces Postgres, DRM KEKs, strict profiles…)
ENV=dev
SECRET_KEY=change-me
LOG_LEVEL=INFO
# LOG_JSON=true            # default: JSON everywhere except dev
FLASK_APP=app.wsgi

# Storage
DATABASE_URL=sqlite:///instance/database.db
# DATABASE_URL=postgresql://neotv:neotv@localhost:5432/neotv
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Redis-less development (no worker/beat; tasks run inline):
# CELERY_ALWAYS_EAGER=true
# REDIS_URL=fakeredis://dev

# HTTP
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
TRUSTED_PROXY_COUNT=0

# Tokens (seconds)
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000
PROFILE_TOKEN_TTL_S=43200
PLAYBACK_GRANT_TTL_S=21600
# COOKIE_SECURE=true       # default: secure everywhere except dev/test
PROFILE_CONTEXT_MODE=default_profile

# Modules (puzzle pieces) to switch off, comma separated, e.g. recommendations,drm
DISABLED_MODULES=

# Streaming
# HLS_OUTPUT_ROOT=/dev/shm/neotv-hls
HLS_SERVE_VIA_NGINX=false
TRANSCODE_ENCODERS=h264_nvenc,h264_qsv,h264_videotoolbox,libx264
TRANSCODE_IDLE_GRACE_S=60
INGEST_CALLBACK_ALLOWED_IPS=127.0.0.1,::1
RTMP_INTERNAL_BASE=rtmp://127.0.0.1:1935/live
# EPG_XMLTV_URL=https://example.com/guide.xml
DEFAULT_MAX_STREAMS=1

# Outbound HTTP (SSRF guard)
EGRESS_ALLOWED_PORTS=80,443,8080,8000,8443
EGRESS_INSECURE_TLS_HOSTS=

# DRM — Fernet keys, newest first (generate: flask drm generate-kek). Required in prod.
DRM_KEK_KEYS=

# Billing: fake (dev/test) | hmac (generic hosted checkout)
PAYMENT_PROVIDER=fake
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_CHECKOUT_URL_TEMPLATE=https://pay.example.com/checkout/{session_id}
TRIAL_DAYS=7
GRACE_DAYS=3

# E-mail (notifications module)
# console = dev: mail is written to var/mail/*.eml and its links are logged.
# smtp    = production (required in prod). Prod refuses console/memory.
EMAIL_BACKEND=console
EMAIL_FROM=NeoTV <no-reply@localhost>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Metadata (tmdb module) — titles, synopses, artwork, genres, episodes in TR + EN.
# themoviedb.org → Settings → API → "API Read Access Token" (the long eyJ… value). Keep it secret.
# TMDB_READ_TOKEN=

# Observability
# OTEL_ENDPOINT=http://localhost:4317
# METRICS_TOKEN=
