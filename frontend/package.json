{
  "name": "neotv-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:api && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "gen:api": "node scripts/gen-api.mjs",
