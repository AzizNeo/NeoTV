{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "IPTV: Start Full System",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python.exe start.py",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "IPTV: Start Backend Only",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python.exe run.py",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "IPTV: Start Frontend Only",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}
